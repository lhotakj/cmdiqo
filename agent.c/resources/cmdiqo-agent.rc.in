#include <windows.h>

#define IDI_APP_ICON 101
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#define RT_MANIFEST 24

IDI_APP_ICON ICON "@CMDIQO_AGENT_ICON_PATH@"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@CMDIQO_AGENT_MANIFEST_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @CMDIQO_RC_FILEVERSION@
PRODUCTVERSION  @CMDIQO_RC_PRODUCTVERSION@
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Cmdiqo"
            VALUE "FileDescription",  "Cmdiqo Remote Host Agent"
            VALUE "FileVersion",      "@CMDIQO_AGENT_VERSION@"
            VALUE "InternalName",     "cmdiqo-agent"
            VALUE "LegalCopyright",   "Copyright (C) @CMDIQO_COPYRIGHT_YEAR@ Jaroslav Lhotak"
            VALUE "OriginalFilename", "cmdiqo-agent.exe"
            VALUE "ProductName",      "Cmdiqo Agent"
            VALUE "ProductVersion",   "@CMDIQO_AGENT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
