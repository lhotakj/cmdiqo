[Unit]
Description=ShangoHub Agent (shango-agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Configuration via environment file or JSON file
EnvironmentFile=-/etc/shango-agent/agent.env
ExecStart=/usr/local/bin/shango-agent
Restart=always
RestartSec=5s
LimitNOFILE=65536

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
