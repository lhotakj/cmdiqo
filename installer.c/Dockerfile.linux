# syntax=docker/dockerfile:1
# Ubuntu 22.04 keeps Linux installer artifacts compatible with glibc 2.35.
FROM ubuntu:22.04

LABEL org.opencontainers.image.title="Cmdiqo native-installer Linux builder" \
      org.opencontainers.image.description="C++20, wxWidgets, and vcpkg builder for installer.c" \
      org.opencontainers.image.vendor="Cmdiqo"

ARG DEBIAN_FRONTEND=noninteractive
ARG VCPKG_COMMIT=07f4812200df3d3c931c0c8a6081d3b21fe2bf9f
ARG BUILDER_INPUT_SHA=unknown

LABEL io.cmdiqo.installer-builder.build-input-sha256="${BUILDER_INPUT_SHA}"

# wxWidgets and its vcpkg dependencies need the GTK/X11/OpenGL development
# stack. The remaining packages support vcpkg ports, diagnostics, and source
# acquisition without requiring changes to the host. Ubuntu 22.04's apt CMake
# is older than this project's 3.24 minimum, so pip installs the active CMake.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        autoconf \
        autoconf-archive \
        automake \
        bison \
        build-essential \
        ca-certificates \
        ccache \
        cmake \
        curl \
        file \
        flex \
        gdb \
        gettext \
        git \
        gperf \
        libasound2-dev \
        libbz2-dev \
        libcairo2-dev \
        libdbus-1-dev \
        libegl1-mesa-dev \
        libexpat1-dev \
        libfontconfig1-dev \
        libfreetype6-dev \
        libgdk-pixbuf-2.0-dev \
        libgl1-mesa-dev \
        libgles2-mesa-dev \
        libglu1-mesa-dev \
        libgtk-3-dev \
        libharfbuzz-dev \
        libjpeg-dev \
        liblzma-dev \
        libncurses-dev \
        libpango1.0-dev \
        libpng-dev \
        libpulse-dev \
        libreadline-dev \
        libssl-dev \
        libtiff-dev \
        libtool \
        libtool-bin \
        libltdl-dev \
        libzip-dev \
        libwayland-dev \
        libwebp-dev \
        libx11-dev \
        libxcb1-dev \
        libxcursor-dev \
        libxext-dev \
        libxi-dev \
        libxinerama-dev \
        libxkbcommon-dev \
        libxkbcommon-x11-dev \
        libxrandr-dev \
        lldb \
        ltrace \
        m4 \
        nasm \
        ninja-build \
        patch \
        perl \
        pkg-config \
        python3 \
        python3-pip \
        python3-venv \
        rsync \
        strace \
        tar \
        unzip \
        valgrind \
        wget \
        xz-utils \
        zip \
    && python3 -m pip install --no-cache-dir "cmake>=3.24,<4" \
    && cmake --version \
    && rm -rf /var/lib/apt/lists/*

# Keep vcpkg outside the mounted source tree. Pinning the revision makes image
# rebuilds deterministic; runtime binary packages are cached in the workspace.
RUN git clone https://github.com/microsoft/vcpkg.git /opt/vcpkg \
    && git -C /opt/vcpkg checkout --detach "${VCPKG_COMMIT}" \
    && /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics \
    && /opt/vcpkg/vcpkg version \
    && chmod -R a+rwx /opt/vcpkg

ENV VCPKG_ROOT=/opt/vcpkg \
    VCPKG_INSTALLED_DIR=/opt/cmdiqo-vcpkg-installed \
    VCPKG_DISABLE_METRICS=1 \
    PATH=/opt/vcpkg:/usr/local/bin:${PATH}

# Keep this layer dependent only on the manifest. The full dependency graph is
# then ready before the bind-mounted project is compiled on the host.
COPY vcpkg.json /tmp/cmdiqo-manifest/vcpkg.json
# The build runner maps the host UID/GID into the container. vcpkg still takes
# a manifest lock while it verifies these prebuilt packages.
RUN --mount=type=cache,target=/opt/vcpkg/downloads \
    /opt/vcpkg/vcpkg install \
        --x-manifest-root=/tmp/cmdiqo-manifest \
        --triplet=x64-linux \
        --x-install-root="${VCPKG_INSTALLED_DIR}" \
    && chmod -R a+rwx "${VCPKG_INSTALLED_DIR}"

RUN chmod -R a+rwx /opt/vcpkg

WORKDIR /workspace
