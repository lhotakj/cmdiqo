#!/usr/bin/env bash

info() {
    echo -e "\033[0;32m[INFO]\033[0m $1"
}

error() {
    echo -e "\033[0;31m[ERROR]\033[0m $1"
}

warn() {
    echo -e "\033[0;33m[WARN]\033[0m $1"
}

BLUE="\033[34m"
RESET="\033[0m"

# Get Python version
PYTHON_BIN="python3"
if ! command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python"
fi
PYTHON_VERSION=$($PYTHON_BIN --version 2>&1)

# Check if existing venv is broken (e.g., after system Python upgrade)
if [ -d .venv ]; then
    if [ -f .venv/bin/$PYTHON_BIN ] && ! .venv/bin/$PYTHON_BIN --version >/dev/null 2>&1; then
        warn "Existing .venv is broken or built for a different Python version. Removing..."
        rm -rf .venv
    elif [ -f .venv/bin/python ] && ! .venv/bin/python --version >/dev/null 2>&1; then
        warn "Existing .venv is broken or built for a different Python version. Removing..."
        rm -rf .venv
    elif [ -f .venv/Scripts/python.exe ] && ! .venv/Scripts/python.exe --version >/dev/null 2>&1; then
        warn "Existing .venv is broken or built for a different Python version. Removing..."
        rm -rf .venv
    fi
fi

# Create venv if missing
if [ ! -d .venv ]; then
    info "Creating Python ${BLUE}$PYTHON_VERSION${RESET} venv ..."
    if ! $PYTHON_BIN -m venv .venv; then
        error "Failed to create virtual environment."
        error "You might need to install ${BLUE}python3-venv${RESET} or ${BLUE}python3-full${RESET}."
        error "On Debian/Ubuntu: sudo apt install python3-venv"
        rm -rf .venv
        return 1
    fi
fi

# Activate venv (supports both POSIX and Windows/Git-Bash layouts)
if [ -f .venv/bin/activate ]; then
    info "Activating Python ${BLUE}$PYTHON_VERSION${RESET} virtual environment ..."
    source .venv/bin/activate
elif [ -f .venv/Scripts/activate ]; then
    info "Activating Windows Python ${BLUE}$PYTHON_VERSION${RESET} virtual environment ..."
    source .venv/Scripts/activate
else
    error "Virtual environment not found or invalid. Removing ${BLUE}.venv${RESET} ..."
    rm -rf .venv
    error "Try again now"
    return 1
fi

# Install requirements if present using activated venv's python
if [ -f requirements.txt ]; then
    info "Installing dependencies from ${BLUE}requirements.txt${RESET} ..."
    $PYTHON_BIN -m pip install -q -r requirements.txt
fi
if [ -f requirements-dev.txt ]; then
    info "Installing dev dependencies from ${BLUE}requirements-dev.txt${RESET} ..."
    $PYTHON_BIN -m pip install -q -r requirements-dev.txt
fi
if [ -f agent/requirements.txt ]; then
    info "Installing agent dependencies from ${BLUE}agent/requirements.txt${RESET} ..."
    $PYTHON_BIN -m pip install -q -r agent/requirements.txt
fi

# Decrypt secrets from secrets/*.gpg to .secrets.*
if [ -d secrets ]; then
    for gpg_file in secrets/*.gpg; do
        if [ -f "$gpg_file" ]; then
            env_name=$(basename "$gpg_file" .gpg)
            env_file=".secrets.$env_name"

            if [ ! -f "$env_file" ] || [ "$gpg_file" -nt "$env_file" ]; then
                info "Decrypting ${BLUE}$gpg_file${RESET} to ${BLUE}$env_file${RESET} ..."
                if ! gpg --quiet --batch --yes --decrypt --output "$env_file" "$gpg_file"; then
                    warn "Failed to decrypt ${BLUE}$gpg_file${RESET}"
                fi
            fi
        fi
    done
fi

# Detect and load .secrets.* files
for env_file in .secrets.*; do
    if [ -f "$env_file" ]; then
        info "Loading environment variables from ${BLUE}$env_file${RESET} ..."
        set -a
        source "$env_file"
        set +a
    fi
done

# Load local .env if present
if [ -f .env ]; then
    info "Loading environment variables from ${BLUE}.env${RESET} ..."
    set -a
    source .env
    set +a
fi
