# Universal Linux builder for Cmdiqo Agent and Installer
# Based on Debian 11 Bullseye (glibc 2.31) to guarantee compatibility across
# openSUSE Leap 15.x, SUSE Linux Enterprise Server 15, Ubuntu 20.04+, Debian 11+, and RHEL/Rocky 8+.
FROM python:3.11-slim-bullseye

RUN sed -i '/debian-security/d; /bullseye-updates/d' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        binutils \
        zip \
        tcl \
        tk && \
    rm -rf /var/lib/apt/lists/*

# Tkinter is the installer GUI baseline on Linux and Windows. The Tcl/Tk runtime
# lets PyInstaller collect its data files into the Linux one-file executable.
RUN pip install --no-cache-dir pyinstaller "websockets>=13"
RUN python3 -c "import tkinter; tkinter.Tcl()"

WORKDIR /workspace
